{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "A real estate property listing.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Property title" },
        "price": { "type": "number", "description": "Property price" },
        "location": { "type": "string", "description": "Property location" },
        "rooms": { "type": "number", "description": "Number of rooms" },
        "bathrooms": { "type": "number", "description": "Number of bathrooms" },
        "area": { "type": "number", "description": "Property area in sqm" },
        "images": { "type": "array", "items": { "type": "string" }, "description": "Array of image URLs" },
        "description": { "type": "string", "description": "Property description" },
        "ownerId": { "type": "string", "description": "UID of the owner" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["title", "price", "location", "ownerId"]
    },
    "Lead": {
      "title": "Lead",
      "description": "A potential customer lead.",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string", "description": "ID of the property" },
        "name": { "type": "string", "description": "Lead name" },
        "phone": { "type": "string", "description": "Lead phone number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp" }
      },
      "required": ["propertyId", "phone"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "A user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User UID" },
        "email": { "type": "string", "format": "email", "description": "User email" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User photo URL" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User role" }
      },
      "required": ["uid", "displayName", "role"]
    }
  },
  "firestore": {
    "properties": {
      "schema": "Property",
      "description": "Collection of property listings."
    },
    "leads": {
      "schema": "Lead",
      "description": "Collection of customer leads."
    },
    "users": {
      "schema": "UserProfile",
      "description": "Collection of user profiles."
    }
  }
}
